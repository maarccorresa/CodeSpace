# Copia este archivo a .env (./codespace install lo hace y genera las claves).

# Puerto publicado en el equipo (dentro del contenedor siempre es 3000)
APP_PORT=3000
# 127.0.0.1 si va detrás de un proxy en el mismo equipo
APP_BIND=0.0.0.0

# Seguridad (mínimo 32 caracteres; en producción no arranca con el de ejemplo)
SESSION_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-0000
# true si se sirve por HTTPS (cookie solo segura)
COOKIE_SECURE=false
# true si hay un proxy delante que envía X-Forwarded-For
TRUST_PROXY=false

# Administrador principal (contraseña de 8 caracteres o más)
ADMIN_EMAIL=admin@codespace.local
ADMIN_PASSWORD=cambia-esta-contraseña

# MongoDB en Docker (la URI la monta compose.yaml con estos datos)
MONGO_USER=codespace
MONGO_PASSWORD=cambia-esta-contraseña-de-mongo
MONGO_DB=codespace

# Para ejecutar sin Docker (npm run dev) con un MongoDB propio:
# MONGO_URI=mongodb://localhost:27017/codespace

# Limpieza automática
CLEANUP_INTERVAL_DAYS=1
WORKSPACE_EXPIRY_DAYS=30
